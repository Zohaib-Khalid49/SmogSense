# ── Backend (Express / Node) ──────────────────────────────────
# See backend/.env.example for backend-specific vars (Mongo URI, Gemini key, etc.)
# Backend env vars are NOT prefixed with VITE_ and stay server-side only.

# ── Client (Vite) ────────────────────────────────────────────
# These must start with VITE_ to be available in the browser bundle.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:3000

# Mock switch: 'true' uses mock data (no backend needed), 'false' calls real backend
VITE_USE_MOCKS=true

# Firebase (Phase 4 — push notifications)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
