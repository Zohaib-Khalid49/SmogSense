# ── Backend (Express / Node) ──────────────────────────────────
# These are NOT prefixed with VITE_ and stay server-side only.

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smogsense
MONGODB_DB_NAME=smogsense

# OpenAQ (optional, improves rate limits)
OPENAQ_API_KEY=

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Firebase (push notifications — server-side)
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Client (Vite) ────────────────────────────────────────────
# These must start with VITE_ to be available in the browser bundle.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:3000

# Mock switch: 'true' uses mock data (no backend needed), 'false' calls real backend
VITE_USE_MOCKS=false

# ── Firebase (push notifications — client-side) ─────────────────────
# Get from Firebase Console > Project Settings > General > Your apps.
# Required for browser push notifications. Leave blank to disable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase VAPID key for web push (Firebase Console > Cloud Messaging > Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
